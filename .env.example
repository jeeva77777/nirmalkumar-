# ==========================================
# CTR NIRMAL KUMAR PORTAL ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Local or Cloud like Aiven/RDS)
# Option A: DATABASE_URL (Cloud MySQL with SSL)
# DATABASE_URL=mysql://avnadmin:password@host:port/defaultdb?ssl-mode=REQUIRED
# Option B: Individual connection settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ctr_nirmal_kumar
DB_SSL=false

# Security Salt for OTP Hashing (HMAC-SHA256)
OTP_SECRET=replace_with_a_secure_random_hex_string_32_characters

# ==========================================
# FREE GMAIL SMTP EMAIL OTP CONFIGURATION
# ==========================================
# Gmail SMTP Host: smtp.gmail.com
# Gmail SMTP Port: 587 (STARTTLS)
# Sender Email Address: ironkyle0077@gmail.com
# 
# IMPORTANT GOOGLE SETUP INSTRUCTIONS:
# 1. Sign in to your Google Account (ironkyle0077@gmail.com).
# 2. Go to Google Account Settings -> Security -> 2-Step Verification (turn ON).
# 3. Search for "App Passwords" or navigate to: https://myaccount.google.com/apppasswords
# 4. Create an App Password:
#    - App name: "Petition Portal"
# 5. Google will generate a 16-character code (e.g., "abcd efgh ijkl mnop").
# 6. Copy and paste the 16-character code below as SMTP_APP_PASSWORD (without spaces).
# 
# NOTE: Never use your standard Gmail account password. Only Google App Passwords work with SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ironkyle0077@gmail.com
SMTP_APP_PASSWORD=your_16_character_gmail_app_password_here
SMTP_FROM=CTR Nirmal Kumar Citizen Portal <ironkyle0077@gmail.com>

# Optional SMS Providers (Twilio / MSG91 fallback)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER

MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=YOUR_MSG91_TEMPLATE_ID
MSG91_SENDER_ID=CTRNKL

# Development OTP Testing (Set to true to log OTP to server console during local development)
# Automatically disabled in production (NODE_ENV=production)
OTP_DEV_MODE=false
